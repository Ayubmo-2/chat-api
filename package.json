{
  "name": "chat-api",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:ws": "npm run dev --workspace=apps/ws",
    "dev:frontend": "npm run dev --workspace=frontend",
    "test": "npm run test --workspace=apps/api",
    "test:coverage": "npm run test:coverage --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run generate --workspace=packages/db",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:studio": "npm run studio --workspace=packages/db"
  }
}
